// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String
  role     String?
  posts    Post[]
}

model Service_category {
  id            Int       @id @default(autoincrement())
  title         String
  title_ua      String?
  category      String?
  category_ua   String?
  short_text    String?
  full_text     String?
  slug          String    @unique
  icon_url      String?
  thumbnail_url String?
  image_url     String?
  created_at    DateTime? @default(now())
  service       Service[]
}

model Service {
  id                   Int              @id @default(autoincrement())
  title                String
  title_ua             String?
  short_text           String?
  full_text            String?
  icon_url             String?
  thumbnail_url        String?
  image_url            String?
  created_at           DateTime?        @default(now())
  slug                 String           @unique
  services_category_id Int
  services_category    Service_category @relation(fields: [services_category_id], references: [id])
}

// News Model:
model Post {
  id            Int       @id @default(autoincrement())
  title         String
  title_ua      String?
  category      String?
  category_ua   String?
  short_text    String?
  full_text     String?
  icon_url      String?
  thumbnail_url String?
  image_url     String?
  slug          String    @unique
  like_count    Int
  views         Int
  created_at    DateTime? @default(now())
  author        User      @relation(fields: [author_id], references: [id])
  author_id     Int
}

// Client requests from the site forms. Saved first, delivered to Telegram/email afterwards,
// so a lead survives a delivery failure and can be retried.
model Lead {
  id                  Int        @id @default(autoincrement())
  type                LeadType
  payload             Json // validated form fields (name, phone, email, message, service title)
  source              String? // page path the form was sent from
  env                 String // production | preview | development: tells test leads apart
  status              LeadStatus @default(new)
  telegramDeliveredAt DateTime?
  emailDeliveredAt    DateTime?
  attempts            Int        @default(0)
  lastError           String?
  idempotencyKey      String     @unique // generated by the form on open: a double submit stores one lead
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([status, createdAt])
}

enum LeadType {
  service
  contacts
  subscribe
}

enum LeadStatus {
  new // saved, delivery not attempted yet
  delivered // both channels done
  failed // at least one channel failed; retried later
}
