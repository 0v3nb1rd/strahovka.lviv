# Environment variables used by the site. Names only: never commit real values.
#
# Local: copy to .env.local (all environments) and, for a separate dev database,
# put DATABASE_URL into .env.development.local (used by `next dev` only).
# Vercel: Settings → Environment Variables; or `vercel env pull .env.local`.
# Environments: P = Production, V = Preview (stg), D = local development.

# --- Database (Neon Postgres) ------------------------------------------------
# P: production branch. V and D: a separate Neon branch, so test leads and edits
# never reach the live data. Direct (non-pooled) connection string.
DATABASE_URL=

# --- Admin sign-in (NextAuth) ------------------------------------------------
# P, V, D. Random string, e.g. `openssl rand -base64 32`.
NEXTAUTH_SECRET=
# D only (optional): silences the NextAuth warning locally. Vercel sets it itself.
# NEXTAUTH_URL=http://localhost:3000

# --- reCAPTCHA v2 (checkbox) -------------------------------------------------
# P, V, D. Site key for the widget and secret key for the server check in
# /api/mailer. Without the secret every form submission fails (503).
# The domain list in the reCAPTCHA console must include the stg/preview host.
NEXT_PUBLIC_RECAPTCHA_KEY=
RECAPTCHA_SECRET_KEY=

# --- Lead delivery -----------------------------------------------------------
# P, V (D optional). Telegram bot token from @BotFather and the chat id to send to.
# Use a test chat id for V/D to keep test leads out of the work chat.
TELEGRAM_TOKEN=
TELEGRAM_ID=
# P, V (D optional). Gmail account the notifications are sent from and to,
# with an app password (not the account password).
EMAIL=
EMAIL_PASSWORD=

# --- Admin editor ------------------------------------------------------------
# P, V, D. TinyMCE Cloud API key.
NEXT_PUBLIC_TINY_KEY=

# --- Site URL ----------------------------------------------------------------
# D (optional, default http://localhost:3000). On Vercel the base URL comes from
# system variables (enable "Automatically expose System Environment Variables"):
# NEXT_PUBLIC_VERCEL_ENV, NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL,
# NEXT_PUBLIC_VERCEL_BRANCH_URL, NEXT_PUBLIC_VERCEL_URL, VERCEL_ENV.
NEXT_PUBLIC_URL=
